@page "/admin/pending"
@using MarketplaceApi.Data
@using MarketplaceApi.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@rendermode InteractiveServer

<PageTitle>Annonces en attente - Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Annonces en attente</h1>
    <span class="badge bg-warning fs-5">@_annonces.Count annonces</span>
</div>

@if (_annonces.Any())
{
    <div class="row g-4">
        @foreach (var annonce in _annonces)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    @if (annonce.Images.Any())
                    {
                        <img src="@annonce.Images.OrderBy(i => i.DisplayOrder).First().ImagePath" 
                             class="card-img-top" 
                             style="height: 200px; object-fit: cover;" 
                             alt="@annonce.Title" />
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                             style="height: 200px;">
                            <i class="bi bi-image text-muted fs-1"></i>
                        </div>
                    }
                    
                    <div class="card-body">
                        <h5 class="card-title">@annonce.Title</h5>
                        <p class="card-text">
                            <strong class="text-primary fs-5">@annonce.Price.ToString("N0") €</strong>
                        </p>
                        <p class="card-text">
                            <span class="badge @GetStatusBadgeClass(annonce.Status)">@GetStatusLabel(annonce.Status)</span>
                        </p>
                        <p class="card-text small text-muted">
                            <i class="bi bi-tag me-1"></i>@annonce.Category.Name<br/>
                            <i class="bi bi-geo-alt me-1"></i>@annonce.Wilaya?.Name, @annonce.Commune?.Name<br/>
                            <i class="bi bi-person me-1"></i>@annonce.User.Name<br/>
                            <i class="bi bi-phone me-1"></i>@annonce.User.Phone
                        </p>
                    </div>
                    
                    <div class="card-footer bg-white">
                        <div class="btn-group w-100">
                            <a href="/admin/annonces/@annonce.Id" class="btn btn-outline-primary">
                                <i class="bi bi-eye"></i> Voir
                            </a>
                            <button class="btn btn-success" @onclick="() => ApproveAnnonce(annonce.Id)">
                                <i class="bi bi-check"></i> Approuver
                            </button>
                            <button class="btn btn-danger" @onclick="() => RejectAnnonce(annonce.Id)">
                                <i class="bi bi-x"></i> Refuser
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
        <h4 class="mt-3 text-muted">Aucune annonce en attente</h4>
        <p class="text-muted">Toutes les annonces ont été traitées.</p>
    </div>
}

@code {
    private List<Annonce> _annonces = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAnnonces();
    }

    private async Task LoadAnnonces()
    {
        _annonces = await DbContext.Annonces
            .Include(a => a.User)
            .Include(a => a.Images)
            .Include(a => a.Wilaya)
            .Include(a => a.Commune)
            .Include(a => a.Category)
            .Where(a => a.Status == AnnonceStatus.Pending || a.Status == AnnonceStatus.UnderReview)
            .OrderBy(a => a.CreatedAt)
            .ToListAsync();
    }

    private async Task ApproveAnnonce(int id)
    {
        var annonce = await DbContext.Annonces.FindAsync(id);
        if (annonce != null)
        {
            annonce.Status = AnnonceStatus.Approved;
            await DbContext.SaveChangesAsync();
            await LoadAnnonces();
        }
    }

    private async Task RejectAnnonce(int id)
    {
        var annonce = await DbContext.Annonces.FindAsync(id);
        if (annonce != null)
        {
            annonce.Status = AnnonceStatus.Rejected;
            await DbContext.SaveChangesAsync();
            await LoadAnnonces();
        }
    }

    private string GetStatusBadgeClass(AnnonceStatus status) => status switch
    {
        AnnonceStatus.Pending => "bg-warning",
        AnnonceStatus.UnderReview => "bg-info",
        AnnonceStatus.Approved => "bg-success",
        AnnonceStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetStatusLabel(AnnonceStatus status) => status switch
    {
        AnnonceStatus.Pending => "En attente",
        AnnonceStatus.UnderReview => "En révision",
        AnnonceStatus.Approved => "Approuvée",
        AnnonceStatus.Rejected => "Refusée",
        _ => status.ToString()
    };
}
