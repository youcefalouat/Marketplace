@page "/admin/annonces/{Id:int}"
@using MarketplaceApi.Data
@using MarketplaceApi.DTOs
@using MarketplaceApi.Hubs
@using MarketplaceApi.Models
@using MarketplaceApi.Services
@using Microsoft.AspNetCore.SignalR
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject IHubContext<ChatHub> HubContext
@inject INotificationService NotificationService
@inject ChatConnectionManager ConnectionManager
@rendermode InteractiveServer

<PageTitle>Détail Annonce - Admin</PageTitle>

@if (_annonce == null)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
    </div>
}
else
{
    <div class="mb-4">
        <a href="/admin/pending" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    <div class="row">
        <!-- Left Column - Images & Details -->
        <div class="col-lg-8">
            <!-- Images -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Photos (@_annonce.Images.Count)</h5>
                </div>
                <div class="card-body">
                    @if (_annonce.Images.Any())
                    {
                        <div class="row g-2">
                            @foreach (var image in _annonce.Images.OrderBy(i => i.DisplayOrder))
                            {
                                <div class="col-md-4">
                                    <img src="@image.ImagePath" class="img-fluid rounded" alt="Photo" 
                                         style="width: 100%; height: 200px; object-fit: cover;" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Aucune photo</p>
                    }
                </div>
            </div>

            <!-- Details -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Informations</h5>
                </div>
                <div class="card-body">
                    <h4>@_annonce.Title</h4>
                    <h3 class="text-primary">@_annonce.Price.ToString("N0") DA</h3>
                    
                    <hr />
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p><strong>Catégorie:</strong> @_annonce.Category?.Name</p>
                            <p><strong>État:</strong> @(_annonce.State == ProductState.New ? "Neuf" : "Occasion")</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Localisation:</strong> @_annonce.Wilaya?.Name, @_annonce.Commune?.Name</p>
                            <p><strong>Date:</strong> @_annonce.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                    
                    <p><strong>Description:</strong></p>
                    <p class="text-muted">@_annonce.Description</p>
                </div>
            </div>
            <!-- Reservations -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-calendar-check"></i> Réservations</h5>
                    <span class="badge bg-primary">@_reservations.Count</span>
                </div>
                <div class="card-body">
                    @if (!_reservations.Any())
                    {
                        <p class="text-muted mb-0">Aucune réservation pour cette annonce.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Rang</th>
                                        <th>Nom</th>
                                        <th>Téléphone</th>
                                        <th>Date réservation</th>
                                        <th>Rendez-vous</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var res in _reservations)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">#@res.Rank</span></td>
                                            <td>@res.User.Name</td>
                                            <td>@res.User.Phone</td>
                                            <td>@DateTime.SpecifyKind(res.ReservationDateTime, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <input type="datetime-local"
                                                       class="form-control form-control-sm"
                                                       style="min-width: 180px;"
                                                       value="@(_editingRendezVous.GetValueOrDefault(res.Id, string.Empty))"
                                                       @oninput="e => _editingRendezVous[res.Id] = e.Value?.ToString() ?? string.Empty" />
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary me-1"
                                                        @onclick="() => SaveRendezVous(res.Id)"
                                                        title="Enregistrer rendez-vous">
                                                    <i class="bi bi-save"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => ConfirmDeleteReservation(res.Id)"
                                                        title="Supprimer réservation">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column - Actions & Notes -->
        <div class="col-lg-4">
            <!-- Status & Actions -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Statut</h5>
                    <span class="badge @GetStatusBadgeClass(_annonce.Status)">@GetStatusLabel(_annonce.Status)</span>
                </div>
                <div class="card-body">
                    @if (_annonce.Status == AnnonceStatus.Pending || _annonce.Status == AnnonceStatus.UnderReview)
                    {
                        <div class="d-grid gap-2">
                            <button class="btn btn-success" @onclick="ApproveAnnonce">
                                <i class="bi bi-check-circle"></i> Approuver
                            </button>
                            <button class="btn btn-danger" @onclick="RejectAnnonce">
                                <i class="bi bi-x-circle"></i> Refuser
                            </button>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-outline-warning w-100" @onclick="ResetToPending">
                            <i class="bi bi-arrow-counterclockwise"></i> Remettre en attente
                        </button>
                    }
                </div>
            </div>

            <!-- Admin / Seller Chat -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-chat-dots"></i> Chat avec le vendeur</h5>
                </div>
                <div class="card-body">
                    @if (_moderationThread == null)
                    {
                        <p class="text-muted mb-3">Aucun chat n'a encore ete demarre pour cette annonce.</p>
                        <textarea class="form-control mb-2" rows="3" placeholder="Question à poser au vendeur..." @bind="_moderationDraft"></textarea>
                        <button class="btn btn-outline-primary w-100" @onclick="StartModerationThread" disabled="@string.IsNullOrWhiteSpace(_moderationDraft)">
                            <i class="bi bi-send"></i> Envoyer un message
                        </button>
                    }
                    else
                    {
                        <div class="border rounded p-2 mb-3" style="max-height: 260px; overflow-y: auto;">
                            @if (_moderationMessages.Count == 0)
                            {
                                <p class="text-muted mb-0">Pas encore de messages.</p>
                            }
                            else
                            {
                                @foreach (var msg in _moderationMessages.OrderBy(m => m.SentAt))
                                {
                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between">
                                            <strong>@(msg.SenderId != _annonce.UserId ? "Admin" : _annonce.User.Name)</strong>
                                            <small class="text-muted">@msg.SentAt.ToString("dd/MM/yyyy HH:mm")</small>
                                        </div>
                                        <div class="small">@msg.Content</div>
                                    </div>
                                }
                            }
                        </div>

                        <textarea class="form-control mb-2" rows="2" placeholder="Votre message..." @bind="_moderationDraft"></textarea>
                        <button class="btn btn-primary w-100" @onclick="SendModerationMessage" disabled="@string.IsNullOrWhiteSpace(_moderationDraft)">
                            <i class="bi bi-send"></i> Envoyer
                        </button>
                    }
                </div>
            </div>

            <!-- Seller Info -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-person"></i> Vendeur</h5>
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>@_annonce.User.Name</strong></p>
                    <p class="mb-1"><i class="bi bi-envelope"></i> @_annonce.User.Email</p>
                    <p class="mb-1"><i class="bi bi-telephone"></i> @_annonce.User.Phone</p>
                    <p class="mb-0"><i class="bi bi-geo-alt"></i> @_annonce.User.Wilaya?.Name, @_annonce.User.Commune?.Name</p>
                </div>
            </div>

            <!-- Store Estimate -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-shop"></i> Avantage Magasin</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Estimation prix magasin (DA)</label>
                        <input type="number" class="form-control" @bind="_storeEstimate" step="1" />
                    </div>
                    
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="goodDeal" @bind="_isGoodDeal" />
                        <label class="form-check-label" for="goodDeal">
                            <i class="bi bi-star-fill text-warning"></i> Bonne affaire
                        </label>
                    </div>
                    
                    <button class="btn btn-primary w-100" @onclick="SaveEstimate">
                        <i class="bi bi-save"></i> Enregistrer
                    </button>
                </div>
            </div>

            <!-- Admin Notes -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-sticky"></i> Notes internes</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <textarea class="form-control" rows="3" placeholder="Ajouter une note..." @bind="_newNote"></textarea>
                    </div>
                    <button class="btn btn-outline-primary w-100 mb-3" @onclick="AddNote" disabled="@string.IsNullOrWhiteSpace(_newNote)">
                        <i class="bi bi-plus"></i> Ajouter
                    </button>
                    
                    @if (_annonce.AdminNotes.Any())
                    {
                        <hr />
                        @foreach (var note in _annonce.AdminNotes.OrderByDescending(n => n.CreatedAt))
                        {
                            <div class="border-start border-3 border-primary ps-3 mb-3">
                                <p class="mb-1">@note.Note</p>
                                <small class="text-muted">
                                    @note.Admin.Name - @note.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_showDeleteConfirmModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmer la suppression</h5>
                </div>
                <div class="modal-body">
                    <p>Voulez-vous supprimer cette réservation ? Les rangs seront réordonnés automatiquement.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showDeleteConfirmModal = false">Annuler</button>
                    <button class="btn btn-danger" @onclick="DeleteReservationConfirmed">Supprimer</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Annonce? _annonce;
    private decimal? _storeEstimate;
    private bool _isGoodDeal;
    private string _newNote = "";
    private Conversation? _moderationThread;
    private List<Message> _moderationMessages = new();
    private string _moderationDraft = "";
    private List<Reservation> _reservations = new();
    private Dictionary<int, string> _editingRendezVous = new();
    private bool _showDeleteConfirmModal = false;
    private int _reservationToDeleteId = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAnnonce();
    }

    private async Task LoadAnnonce()
    {
        _annonce = await DbContext.Annonces
            .Include(a => a.User)
                .ThenInclude(u => u.Wilaya)
            .Include(a => a.User)
                .ThenInclude(u => u.Commune)
            .Include(a => a.Wilaya)
            .Include(a => a.Commune)
            .Include(a => a.Category)
            .Include(a => a.Images)
            .Include(a => a.AdminNotes)
                .ThenInclude(n => n.Admin)
            .FirstOrDefaultAsync(a => a.Id == Id);

        if (_annonce != null)
        {
            _storeEstimate = _annonce.StorePriceEstimate;
            _isGoodDeal = _annonce.IsGoodDeal;
        }

        _reservations = await DbContext.Reservations
            .Include(r => r.User)
            .Where(r => r.AnnonceId == Id)
            .OrderBy(r => r.Rank)
            .ToListAsync();

        _editingRendezVous = _reservations.ToDictionary(
            r => r.Id,
            r => r.RendezVousDateTime.HasValue
                ? DateTime.SpecifyKind(r.RendezVousDateTime.Value, DateTimeKind.Utc)
                          .ToLocalTime()
                          .ToString("yyyy-MM-ddTHH:mm")
                : string.Empty);

        _moderationThread = await DbContext.Conversations
            .FirstOrDefaultAsync(t => t.AnnonceId == Id && t.IsModeration);

        if (_moderationThread != null)
        {
            _moderationMessages = await DbContext.Messages
                .Where(m => m.ConversationId == _moderationThread.Id)
                .OrderBy(m => m.SentAt)
                .ToListAsync();
        }
        else
        {
            _moderationMessages = new List<Message>();
        }
    }

    private async Task ApproveAnnonce()
    {
        if (_annonce != null)
        {
            _annonce.Status = AnnonceStatus.Approved;
            await DbContext.SaveChangesAsync();
            await LoadAnnonce();
        }
    }

    private async Task RejectAnnonce()
    {
        if (_annonce != null)
        {
            _annonce.Status = AnnonceStatus.Rejected;
            await DbContext.SaveChangesAsync();
            await LoadAnnonce();
        }
    }

    private async Task ResetToPending()
    {
        if (_annonce != null)
        {
            _annonce.Status = AnnonceStatus.Pending;
            await DbContext.SaveChangesAsync();
            await LoadAnnonce();
        }
    }

    private async Task StartModerationThread()
    {
        if (_annonce == null) return;
        if (string.IsNullOrWhiteSpace(_moderationDraft)) return;

        var adminId = await DbContext.Users.Where(u => u.Role == UserRole.Admin).Select(u => u.Id).FirstOrDefaultAsync();
        if (adminId == 0) adminId = 1;

        _moderationThread ??= new Conversation
        {
            AnnonceId = _annonce.Id,
            BuyerId = adminId, // Admin acts as "buyer" in the conversation
            SellerId = _annonce.UserId,
            IsModeration = true,
            StartedAt = DateTime.UtcNow,
            LastMessageAt = DateTime.UtcNow
        };

        if (_moderationThread.Id == 0)
        {
            DbContext.Conversations.Add(_moderationThread);
            await DbContext.SaveChangesAsync();
        }

        var message = new Message
        {
            ConversationId = _moderationThread.Id,
            SenderId = adminId,
            ReceiverId = _annonce.UserId,
            Content = _moderationDraft,
            SentAt = DateTime.UtcNow,
            IsRead = false
        };

        DbContext.Messages.Add(message);
        _moderationThread.LastMessageAt = DateTime.UtcNow;
        _annonce.Status = AnnonceStatus.UnderReview;

        _moderationDraft = "";
        await DbContext.SaveChangesAsync();

        // Push real-time updates to the mobile app via SignalR
        await PushRealtimeUpdatesAsync(_moderationThread, message, adminId);

        await LoadAnnonce();
    }

    private async Task SendModerationMessage()
    {
        if (_moderationThread == null) return;
        if (_annonce == null) return;
        if (string.IsNullOrWhiteSpace(_moderationDraft)) return;

        var adminId = await DbContext.Users.Where(u => u.Role == UserRole.Admin).Select(u => u.Id).FirstOrDefaultAsync();
        if (adminId == 0) adminId = 1;

        var message = new Message
        {
            ConversationId = _moderationThread.Id,
            SenderId = adminId,
            ReceiverId = _annonce.UserId,
            Content = _moderationDraft,
            SentAt = DateTime.UtcNow,
            IsRead = false
        };

        DbContext.Messages.Add(message);
        _moderationThread.LastMessageAt = DateTime.UtcNow;

        if (_annonce.Status == AnnonceStatus.Pending)
        {
            _annonce.Status = AnnonceStatus.UnderReview;
        }

        _moderationDraft = "";
        await DbContext.SaveChangesAsync();

        // Push real-time updates to the mobile app via SignalR
        await PushRealtimeUpdatesAsync(_moderationThread, message, adminId);

        await LoadAnnonce();
    }

    /// <summary>
    /// Push SignalR events so the mobile app receives the message instantly,
    /// mirroring what ChatController.PushMessageAndConversationUpdatesAsync does.
    /// </summary>
    private async Task PushRealtimeUpdatesAsync(Conversation conversation, Message message, int adminId)
    {
        var receiverId = message.ReceiverId;

        // 1. Push ReceiveMessage to the receiver (seller) so their chat screen updates instantly
        var receiverDto = new MessageDto
        {
            Id = message.Id,
            ConversationId = message.ConversationId,
            SenderId = message.SenderId,
            ReceiverId = message.ReceiverId,
            Content = message.Content,
            SentAt = message.SentAt,
            IsRead = message.IsRead,
            ReadAt = message.ReadAt,
            IsMe = false // From the receiver's perspective, this is not their message
        };

        await HubContext.Clients.Group(ChatHub.GetUserGroupName(receiverId))
            .SendAsync("ReceiveMessage", receiverDto);

        // 2. Push ConversationUpdated so the conversation list updates
        var conversationDto = await BuildConversationDtoForUser(conversation.Id, receiverId);
        if (conversationDto != null)
        {
            await HubContext.Clients.Group(ChatHub.GetUserGroupName(receiverId))
                .SendAsync("ConversationUpdated", conversationDto);
        }

        // 3. Push UnreadCountUpdated so the badge count updates
        var unreadSummary = await BuildUnreadSummaryForUser(receiverId);
        await HubContext.Clients.Group(ChatHub.GetUserGroupName(receiverId))
            .SendAsync("UnreadCountUpdated", unreadSummary);

        // 4. Send push notification via the notification service
        var adminUser = await DbContext.Users.FindAsync(adminId);
        var senderName = adminUser?.Name ?? "Administrateur";
        await NotificationService.SendMessageNotificationAsync(receiverId, receiverDto, senderName);
    }

    private async Task<ConversationDto?> BuildConversationDtoForUser(int conversationId, int userId)
    {
        return await DbContext.Conversations
            .AsNoTracking()
            .Where(c => c.Id == conversationId)
            .Select(c => new ConversationDto
            {
                Id = c.Id,
                AnnonceId = c.AnnonceId,
                AnnonceTitle = c.Annonce.Title,
                AnnonceImage = c.Annonce.Images
                    .OrderBy(i => i.DisplayOrder)
                    .Select(i => i.ThumbnailMediumPath ?? i.ImagePath)
                    .FirstOrDefault() ?? string.Empty,
                AnnoncePrice = c.Annonce.Price,
                AnnonceCurrency = "DA",
                AnnonceOwnerId = c.Annonce.UserId,
                AnnonceCategoryId = c.Annonce.CategoryId,
                AnnonceCategoryName = c.Annonce.Category.Name,
                AnnonceCategoryArName = c.Annonce.Category.ArName,
                AnnonceStatus = c.Annonce.Status.ToString(),
                InterlocutorId = c.BuyerId == userId ? c.Seller.Id : c.Buyer.Id,
                InterlocutorName = c.BuyerId == userId ? c.Seller.Name : c.Buyer.Name,
                LastMessageAt = c.LastMessageAt,
                LastMessageContent = c.Messages
                    .OrderByDescending(m => m.Id)
                    .Select(m => m.Content)
                    .FirstOrDefault() ?? string.Empty,
                LastMessageSenderId = c.Messages
                    .OrderByDescending(m => m.Id)
                    .Select(m => (int?)m.SenderId)
                    .FirstOrDefault(),
                UnreadCount = c.Messages.Count(m => m.ReceiverId == userId && !m.IsRead),
                HasUnreadMessages = c.Messages.Any(m => m.ReceiverId == userId && !m.IsRead),
                IsModeration = c.IsModeration,
                IsInterlocutorOnline = ConnectionManager.IsUserOnline(
                    c.BuyerId == userId ? c.SellerId : c.BuyerId)
            })
            .FirstOrDefaultAsync();
    }

    private async Task<UnreadSummaryDto> BuildUnreadSummaryForUser(int userId)
    {
        var conversations = await DbContext.Messages
            .AsNoTracking()
            .Where(m => m.ReceiverId == userId && !m.IsRead)
            .GroupBy(m => m.ConversationId)
            .Select(g => new UnreadConversationCountDto
            {
                ConversationId = g.Key,
                Count = g.Count()
            })
            .ToListAsync();

        return new UnreadSummaryDto
        {
            TotalUnread = conversations.Sum(c => c.Count),
            Conversations = conversations
        };
    }

    private async Task SaveRendezVous(int reservationId)
    {
        var reservation = await DbContext.Reservations.FindAsync(reservationId);
        if (reservation == null) return;

        if (_editingRendezVous.TryGetValue(reservationId, out var dateStr) && !string.IsNullOrEmpty(dateStr))
        {
            if (DateTime.TryParse(dateStr, out var dt))
            {
                reservation.RendezVousDateTime = dt.ToUniversalTime();
                reservation.UpdatedAt = DateTime.UtcNow;
            }
        }
        else
        {
            reservation.RendezVousDateTime = null;
            reservation.UpdatedAt = DateTime.UtcNow;
        }

        await DbContext.SaveChangesAsync();
        await LoadAnnonce();
    }

    private void ConfirmDeleteReservation(int id)
    {
        _reservationToDeleteId = id;
        _showDeleteConfirmModal = true;
    }

    private async Task DeleteReservationConfirmed()
    {
        _showDeleteConfirmModal = false;
        if (_reservationToDeleteId == 0) return;

        var reservation = await DbContext.Reservations.FindAsync(_reservationToDeleteId);
        if (reservation == null) return;

        var deletedRank = reservation.Rank;
        var annonceId = reservation.AnnonceId;

        await using var transaction = await DbContext.Database.BeginTransactionAsync();
        try
        {
            DbContext.Reservations.Remove(reservation);
            await DbContext.SaveChangesAsync();

            var toReorder = await DbContext.Reservations
                .Where(r => r.AnnonceId == annonceId && r.Rank > deletedRank)
                .ToListAsync();

            foreach (var r in toReorder)
            {
                r.Rank--;
                r.UpdatedAt = DateTime.UtcNow;
            }

            await DbContext.SaveChangesAsync();
            await transaction.CommitAsync();
        }
        catch
        {
            await transaction.RollbackAsync();
        }

        _reservationToDeleteId = 0;
        await LoadAnnonce();
    }

    private async Task SaveEstimate()
    {
        if (_annonce != null)
        {
            _annonce.StorePriceEstimate = _storeEstimate;
            _annonce.IsGoodDeal = _isGoodDeal;
            await DbContext.SaveChangesAsync();
        }
    }

    private async Task AddNote()
    {
        if (_annonce != null && !string.IsNullOrWhiteSpace(_newNote))
        {
            // For demo, using admin ID 1. In production, get from authenticated user
            var adminId = await DbContext.Users.Where(u => u.Role == UserRole.Admin).Select(u => u.Id).FirstOrDefaultAsync();
            if (adminId == 0) adminId = 1;
            
            var note = new AdminNote
            {
                AnnonceId = _annonce.Id,
                AdminId = adminId,
                Note = _newNote,
                CreatedAt = DateTime.UtcNow
            };
            
            DbContext.AdminNotes.Add(note);
            await DbContext.SaveChangesAsync();
            
            _newNote = "";
            await LoadAnnonce();
        }
    }

    private string GetStatusBadgeClass(AnnonceStatus status) => status switch
    {
        AnnonceStatus.Pending => "bg-warning",
        AnnonceStatus.UnderReview => "bg-info",
        AnnonceStatus.Approved => "bg-success",
        AnnonceStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetStatusLabel(AnnonceStatus status) => status switch
    {
        AnnonceStatus.Pending => "En attente",
        AnnonceStatus.UnderReview => "En révision",
        AnnonceStatus.Approved => "Approuvée",
        AnnonceStatus.Rejected => "Refusée",
        _ => status.ToString()
    };
}
