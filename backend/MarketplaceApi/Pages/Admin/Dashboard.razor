@page "/admin"
@using MarketplaceApi.Data
@using MarketplaceApi.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<PageTitle>Dashboard - Admin</PageTitle>

<h1 class="mb-4">Dashboard</h1>

<div class="row g-4 mb-4">
    <!-- Stats Cards -->
    <div class="col-md-3">
        <div class="card bg-warning text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-2">En attente</h6>
                        <h2 class="card-title mb-0">@_pendingCount</h2>
                    </div>
                    <i class="bi bi-hourglass-split fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card bg-success text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-2">Approuvées</h6>
                        <h2 class="card-title mb-0">@_approvedCount</h2>
                    </div>
                    <i class="bi bi-check-circle fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card bg-danger text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-2">Refusées</h6>
                        <h2 class="card-title mb-0">@_rejectedCount</h2>
                    </div>
                    <i class="bi bi-x-circle fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card bg-info text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-2">Bonnes affaires</h6>
                        <h2 class="card-title mb-0">@_goodDealsCount</h2>
                    </div>
                    <i class="bi bi-star fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Pending -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Dernières annonces en attente</h5>
        <a href="/admin/pending" class="btn btn-sm btn-outline-primary">Voir tout</a>
    </div>
    <div class="card-body">
        @if (_recentPending.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Titre</th>
                            <th>Prix</th>
                            <th>Catégorie</th>
                            <th>Vendeur</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var annonce in _recentPending)
                        {
                            <tr>
                                <td>@annonce.Title</td>
                                <td>@annonce.Price.ToString("N0") €</td>
                                <td>@annonce.Category.Name</td>
                                <td>@annonce.User.Name</td>
                                <td>@annonce.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a href="/admin/annonces/@annonce.Id" class="btn btn-sm btn-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">Aucune annonce en attente</p>
        }
    </div>
</div>

@code {
    private int _pendingCount;
    private int _approvedCount;
    private int _rejectedCount;
    private int _goodDealsCount;
    private List<Annonce> _recentPending = new();

    protected override async Task OnInitializedAsync()
    {
        _pendingCount = await DbContext.Annonces.CountAsync(a => a.Status == AnnonceStatus.Pending);
        _approvedCount = await DbContext.Annonces.CountAsync(a => a.Status == AnnonceStatus.Approved);
        _rejectedCount = await DbContext.Annonces.CountAsync(a => a.Status == AnnonceStatus.Rejected);
        _goodDealsCount = await DbContext.Annonces.CountAsync(a => a.IsGoodDeal);
        
        _recentPending = await DbContext.Annonces
            .Include(a => a.User)
            .Include(a => a.Category)
            .Where(a => a.Status == AnnonceStatus.Pending)
            .OrderByDescending(a => a.CreatedAt)
            .Take(5)
            .ToListAsync();
    }
}
