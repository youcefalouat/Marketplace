@inherits LayoutComponentBase

<div class="d-flex">
    <!-- Sidebar -->
    <nav class="sidebar bg-dark text-white p-3" style="width: 250px; min-height: 100vh;">
        <div class="sidebar-header mb-4">
            <h4 class="mb-0">
                <i class="bi bi-shop me-2"></i>
                Admin
            </h4>
            <small class="text-muted">Marketplace Contrôlée</small>
        </div>
        
        <ul class="nav flex-column">
            <li class="nav-item">
                <NavLink class="nav-link text-white" href="/admin" Match="NavLinkMatch.All">
                    <i class="bi bi-speedometer2 me-2"></i>
                    Dashboard
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link text-white" href="/admin/pending">
                    <i class="bi bi-hourglass-split me-2"></i>
                    Annonces en attente
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link text-white" href="/admin/annonces">
                    <i class="bi bi-list-ul me-2"></i>
                    Toutes les annonces
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link text-white" href="/admin/good-deals">
                    <i class="bi bi-star me-2"></i>
                    Bonnes affaires
                </NavLink>
            </li>
        </ul>
    </nav>
    
    <!-- Main Content -->
    <main class="flex-grow-1">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-4">
            <span class="navbar-brand mb-0 h1">Back-Office Administration</span>
        </nav>
        
        <div class="container-fluid p-4">
            @Body
        </div>
    </main>
</div>

<style>
    .sidebar .nav-link:hover {
        background-color: rgba(255,255,255,0.1);
        border-radius: 5px;
    }
    
    .sidebar .nav-link.active {
        background-color: rgba(255,255,255,0.2);
        border-radius: 5px;
    }
</style>
