# Docker Compose settings for local or VPS deployment.
# Copy this file to .env and replace the placeholder secrets before starting.

ASPNETCORE_ENVIRONMENT=Production

# SQL Server
MSSQL_SA_PASSWORD=Change_this_Strong_Password_123!
MARKETPLACE_DB_NAME=MarketplaceDb
MARKETPLACE_DB_PORT=1433


EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USE_SSL=true
EMAIL_SENDER_EMAIL=cashbuy.support@gmail.com
EMAIL_SENDER_NAME=Cash buy قش البيع
EMAIL_USERNAME=
EMAIL_BASE_URL=http://localhost:5000
SMTP_PASSWORD=nksv ozlo iygh vgdy
# API
MARKETPLACE_API_PORT=5000
JWT_SECRET=Change_this_to_a_random_64_character_secret_before_deploying
JWT_ISSUER=MarketplaceApi
JWT_AUDIENCE=MarketplaceApp

# Fresh database startup. Keep migrations/reference data enabled for a clean VPS DB.
RUN_MIGRATIONS_ON_STARTUP=true
SEED_REFERENCE_DATA_ON_STARTUP=true

# Optional initial admin. Set SEED_DEFAULT_ADMIN_ON_STARTUP=true only when needed.
SEED_DEFAULT_ADMIN_ON_STARTUP=false
DEFAULT_ADMIN_EMAIL=admin@marketplace.com
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Administrateur
DEFAULT_ADMIN_PHONE=0600000000

# Optional Azure Blob storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_BASE_URL=

# Optional Twilio SMS verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFICATION_SERVICE_SID=

# Optional SMTP email verification
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USE_SSL=true
EMAIL_SENDER_EMAIL=
EMAIL_SENDER_NAME=Marketplace Controlee
EMAIL_USERNAME=
EMAIL_BASE_URL=https://your-domain.example
SMTP_PASSWORD=
